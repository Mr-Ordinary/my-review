<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- stage 表：全部查询带 user_id（AuthContext 传入），跨用户数据天然不可见 -->
<mapper namespace="com.review.vt.mapper.StageMapper">

    <resultMap id="StageMap" type="com.review.vt.pojo.entity.Stage">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="name" column="name"/>
        <result property="status" column="status"/>
        <result property="summaryJson" column="summary_json"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="completedAt" column="completed_at"/>
    </resultMap>

    <sql id="cols">
        id, user_id, name, status, summary_json, created_at, updated_at, completed_at
    </sql>

    <select id="selectByIdScoped" resultMap="StageMap">
        SELECT <include refid="cols"/> FROM stage WHERE id = #{id} AND user_id = #{userId}
    </select>

    <select id="countById" resultType="int">
        SELECT COUNT(*) FROM stage WHERE id = #{id} AND user_id = #{userId}
    </select>


    <!-- 全列更新（含 null）：旧 saveRow 语义——清空某列必须真的清掉 -->

    <delete id="deleteByIdScoped">
        DELETE FROM stage WHERE id = #{id} AND user_id = #{userId}
    </delete>

    <select id="selectAllDesc" resultMap="StageMap">
        SELECT <include refid="cols"/> FROM stage WHERE user_id = #{userId} ORDER BY updated_at DESC
    </select>

    <!-- 启动热备专用：全用户、按主键键集分页，请求路径禁用 -->
    <select id="selectChunkForWarmup" resultMap="StageMap">
        SELECT <include refid="cols"/> FROM stage
        WHERE id &gt; #{afterId} ORDER BY id ASC LIMIT #{limit}
    </select>

    <select id="selectIdsByUserId" resultType="java.lang.Long">
        SELECT id FROM stage WHERE user_id = #{userId} ORDER BY updated_at DESC
    </select>

    <select id="selectByIds" resultMap="StageMap">
        SELECT <include refid="cols"/> FROM stage
        WHERE id IN
        <foreach collection="ids" item="item" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>
</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- review_doc 表：全部查询带 user_id。content_json 是 v3 前的遗留大字段，已迁到 review_card，不再读写 -->
<mapper namespace="com.review.vt.mapper.ReviewDocMapper">

    <resultMap id="ReviewDocMap" type="com.review.vt.pojo.entity.ReviewDoc">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="practiceId" column="practice_id"/>
        <result property="status" column="status"/>
        <result property="progressJson" column="progress_json"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="cols">
        id, user_id, practice_id, status, progress_json, created_at, updated_at
    </sql>

    <select id="selectByIdScoped" resultMap="ReviewDocMap">
        SELECT <include refid="cols"/> FROM review_doc WHERE id = #{id} AND user_id = #{userId}
    </select>

    <select id="selectByPracticeScoped" resultMap="ReviewDocMap">
        SELECT <include refid="cols"/> FROM review_doc
        WHERE user_id = #{userId} AND practice_id = #{practiceId}
    </select>



    <delete id="deleteByIds">
        DELETE FROM review_doc WHERE user_id = #{userId} AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <!-- 启动热备专用：全用户、按主键键集分页，请求路径禁用 -->
    <select id="selectChunkForWarmup" resultMap="ReviewDocMap">
        SELECT <include refid="cols"/> FROM review_doc
        WHERE id &gt; #{afterId} ORDER BY id ASC LIMIT #{limit}
    </select>
</mapper>

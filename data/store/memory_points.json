}, {
  "id" : "mig-76771dc4-7bc2-407c-bf72-d49780af7226-38",
  "practiceId" : "b9342912-56c3-4f5b-881a-a725a35dbff3",
  "questionId" : "9d422e9a-7f99-4c9c-9a9f-a06373d8edd1",
  "pointNamesJson" : "[\"红黑树 · 在HashMap中的简化实现\"]",
  "text" : "HashMap 仍非线程安全，死循环风险消除不等于并发安全",
